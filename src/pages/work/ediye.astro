---
import Layout from '../../layouts/Layout.astro'
---

<Layout title="eDiye – Work">
  <section class="project-detail">
    <div class="project-detail__inner">
      <a href="/work" class="project-detail__back">← Back</a>

      <div class="project-detail__header">
        <div class="project-detail__thumb">
          <img src="/images/projects/ediye.webp" alt="eDiye website and app development studio" />
        </div>
        <div class="project-detail__intro">
          <h1 class="project-detail__title">eDiye</h1>
          <p class="project-detail__tagline">website/app development studio</p>
        </div>
      </div>

      <div class="project-detail__meta">
        <div class="project-detail__meta-item">
          <span class="project-detail__meta-label">Year</span>
          <span class="project-detail__meta-value">2024</span>
        </div>
        <div class="project-detail__meta-item">
          <span class="project-detail__meta-label">Industry</span>
          <span class="project-detail__meta-value">Technology</span>
        </div>
        <div class="project-detail__meta-item">
          <span class="project-detail__meta-label">Service</span>
          <span class="project-detail__meta-value">Ui/Ux Design</span>
        </div>
      </div>

      <div class="project-detail__content">
        <p>eDiye is a development studio focused on building digital products that solve real problems. The project involved designing a brand identity and web presence that communicates technical capability with clarity and confidence.</p>
        <p>My role encompassed the full design process — from research and strategy through to high-fidelity visuals and development handoff, ensuring the final product felt cohesive and purposeful.</p>
      </div>
    </div>
  </section>
</Layout>

<style lang="scss">
  .project-detail {
    padding: 4rem 2rem 6rem;

    &__inner {
      max-width: 50rem;
      margin: 0 auto;
    }

    &__back {
      display: inline-block;
      margin-bottom: 2rem;
      font: 400 0.875rem / 1 font-family(fraktion);
      color: color(secondary);
      opacity: 0.6;
      text-decoration: none;
      transition: opacity 0.2s;

      &:hover {
        opacity: 1;
      }
    }

    &__header {
      margin-bottom: 2.5rem;
    }

    &__thumb {
      width: 100%;
      max-height: 24rem;
      overflow: hidden;
      margin-bottom: 2rem;

      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    }

    &__title {
      margin: 0 0 0.5rem;
      font: 700 3.5rem / 0.9 font-family(bigger);
      text-transform: uppercase;
      color: color(secondary);
    }

    &__tagline {
      margin: 0;
      font: 200 1.25rem / 1.5 font-family(editorial);
      color: color(secondary);
      opacity: 0.7;
    }

    &__meta {
      display: flex;
      gap: 3rem;
      margin-bottom: 3rem;
      padding: 1.5rem 0;
      border-top: 1px solid color(secondary);
      border-bottom: 1px solid color(secondary);
    }

    &__meta-item {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    &__meta-label {
      font: 700 0.7rem / 1 font-family(fraktion);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: color(secondary);
      opacity: 0.5;
    }

    &__meta-value {
      font: 400 1rem / 1 font-family(fraktion);
      color: color(secondary);
    }

    &__content {
      p {
        font: 200 1.25rem / 1.7 font-family(editorial);
        color: color(secondary);
        margin: 0 0 1.5rem;
      }
    }
  }
</style>
